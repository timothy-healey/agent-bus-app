{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  // The mock mirrors the app's `src/ipc/*.ts` types so `tsc` here catches contract
  // drift (the hand-written-mock risk — see README). It deliberately includes the
  // app's ipc types via relative imports; the app's own root tsconfig EXCLUDES
  // this dir so the default `tsc --noEmit` never collects it.
  "include": ["**/*.ts", "mock/**/*.ts", "specs/**/*.ts", "playwright.config.ts"]
}
